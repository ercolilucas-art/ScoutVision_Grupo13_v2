@model List<ScoutVision.Web.Models.EquipoResumenViewModel>

@{
    ViewData["Title"] = "Equipos";

    int totalEquipos = Model.Count;
    int totalJugadores = Model.Sum(e => e.CantidadJugadores);
}

<style>
    /* Resumen general */

    .equipos-resumen {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin: 26px 0;
    }

    .equipos-resumen-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 24px;
    }

        .equipos-resumen-card span {
            display: block;
            color: #a7bdcc;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .equipos-resumen-card strong {
            display: block;
            color: #eef6fb;
            font-size: 34px;
            font-weight: 800;
        }

    /* Grilla de clubes */

    .equipos-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .equipo-card {
        display: flex;
        flex-direction: column;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 26px;
        transition: border-color .2s, transform .2s;
        min-width: 0;
    }

        .equipo-card:hover {
            border-color: rgba(159, 234, 88, .45);
            transform: translateY(-3px);
        }

    .equipo-card-top {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 25px;
    }

    .equipo-icono {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        width: 60px;
        height: 60px;
        background: rgba(159, 234, 88, .10);
        border: 1px solid rgba(159, 234, 88, .20);
        border-radius: 14px;
        color: #9fea58;
        font-size: 25px;
        font-weight: 800;
    }

    .equipo-nombre {
        margin: 0;
        color: #eef6fb;
        font-size: 21px;
        font-weight: 800;
        line-height: 1.3;
    }

    .equipo-subtitulo {
        margin-top: 6px;
        color: #a7bdcc;
        font-size: 13px;
    }

    /* Información del plantel */

    .equipo-info {
        padding: 20px 0;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        margin-bottom: 22px;
    }

    .equipo-info-label {
        display: block;
        color: #a7bdcc;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .equipo-info-numero {
        display: block;
        color: #eef6fb;
        font-size: 30px;
        font-weight: 800;
    }

    /* Acciones */

    .equipo-acciones {
        display: flex;
        gap: 10px;
        margin-top: auto;
    }

    .equipo-ver {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        width: 100%;
        min-height: 45px;
        padding: 10px 16px;
        color: #071b10;
        background: var(--green);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none;
        transition: opacity .2s;
    }

        .equipo-ver:hover {
            opacity: .85;
            color: #071b10;
        }

        .equipo-ver:focus-visible {
            outline: 2px solid #eef6fb;
            outline-offset: 3px;
        }

    /* Secciones y aclaraciones */

    .equipos-titulo-seccion {
        margin: 30px 0 8px;
        color: #eef6fb;
        font-size: 22px;
        font-weight: 800;
    }

    .equipos-descripcion {
        color: #a7bdcc;
        font-size: 14px;
        line-height: 1.6;
    }

    .equipos-vacio {
        padding: 35px;
        text-align: center;
        color: #a7bdcc;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 16px;
    }

    .equipos-nota {
        color: #a7bdcc;
        font-size: 13px;
        line-height: 1.6;
        margin-top: 24px;
    }

    /* Adaptación móvil */

    @@media (max-width: 850px) {
        .equipos-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .equipos-resumen {
            gap: 12px;
        }

        .equipos-resumen-card {
            padding: 17px;
        }

            .equipos-resumen-card strong {
                font-size: 28px;
            }

        .equipo-card {
            padding: 20px;
        }

        .equipo-nombre {
            font-size: 18px;
        }
    }
</style>

<!-- Encabezado -->

<div class="page-header">
    <div>
        <h1>Equipos <span>analizados</span></h1>
        <p>
            Exploración de clubes, planteles y jugadores
            registrados en ScoutVision.
        </p>
    </div>

    <div class="season-chip">
        Temporada 2026
    </div>
</div>

<!-- Resumen general -->

<div class="equipos-resumen">

    <div class="equipos-resumen-card">
        <span>Equipos registrados</span>
        <strong>@totalEquipos</strong>
    </div>

    <div class="equipos-resumen-card">
        <span>Jugadores registrados</span>
        <strong>@totalJugadores</strong>
    </div>

</div>

<!-- Listado de clubes -->

<h2 class="equipos-titulo-seccion">
    Clubes disponibles
</h2>

<p class="equipos-descripcion">
    Seleccioná un club para consultar sus futbolistas
    y acceder a sus estadísticas individuales.
</p>

@if (Model.Count == 0)
{
    <div class="equipos-vacio">
        No hay equipos registrados en la base de datos.
    </div>
}
else
{
    <div class="equipos-grid">

        @foreach (var equipo in Model)
        {
            <article class="equipo-card">

                <div class="equipo-card-top">

                    <div class="equipo-icono">
                        @equipo.Nombre.Substring(0, 1).ToUpper()
                    </div>

                    <div>
                        <h3 class="equipo-nombre">
                            @equipo.Nombre
                        </h3>

                        <div class="equipo-subtitulo">
                            Club registrado en ScoutVision
                        </div>
                    </div>

                </div>

                <div class="equipo-info">

                    <span class="equipo-info-label">
                        Futbolistas del plantel
                    </span>

                    <strong class="equipo-info-numero">
                        @equipo.CantidadJugadores
                    </strong>

                </div>

                <div class="equipo-acciones">

                    <a class="equipo-ver"
                       asp-controller="Jugadores"
                       asp-action="Index"
                       asp-route-equipoId="@equipo.Id">

                        Ver plantel
                        <span aria-hidden="true">→</span>

                    </a>

                </div>

            </article>
        }

    </div>
}

<p class="equipos-nota">
    Los equipos y sus jugadores se obtienen directamente
    de PostgreSQL. Los planteles cargados son datos de
    demostración académica.
</p>

